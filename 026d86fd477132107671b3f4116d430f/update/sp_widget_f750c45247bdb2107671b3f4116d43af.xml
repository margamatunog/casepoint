<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="INSERT_OR_UPDATE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function(spUtil) {
  var c = this;
  
  c.submitCase = function() {
    c.submitted_attempt = true;
    if (!c.short_desc || !c.description) return;
    
    c.submitting = true;
    c.server.get({
      action: 'submit_case',
      short_description: c.short_desc,
      description: c.description
    }).then(function(r) {
      c.submitting = false;
      c.data.submitted = true;
      c.data.new_case_number = r.data.new_case_number;
      // Optional: Redirect after delay
      // $window.location.href = "?id=cp_case_details&sys_id=" + r.data.new_case_id;
    });
  };
};
]]></client_script>
        <controller_as>c</controller_as>
        <css/>
        <data_table>sp_instance</data_table>
        <demo_data/>
        <description/>
        <docs/>
        <field_list/>
        <has_preview>false</has_preview>
        <id>cp_simple_form</id>
        <internal>false</internal>
        <link><![CDATA[function link(scope, element, attrs, controller) {  }]]></link>
        <name>CasePoint Simple Form</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
  data.user_name = gs.getUserDisplayName();
  
  if (input && input.action == 'submit_case') {
    var gr = new GlideRecordSecure('x_1603911_casepo_0_legal_case');
    gr.initialize();
    gr.setValue('legal_requestor', gs.getUserID());
    gr.setValue('short_description', input.short_description);
    gr.setValue('description', input.description);
    gr.setValue('case_summary', input.description); // Initial summary
    
    if (gr.insert()) {
      data.submitted = true;
      data.new_case_number = gr.getValue('number');
      data.new_case_id = gr.getUniqueValue();
    } else {
      data.error = "Error submitting case.";
    }
  }
})();]]></script>
        <servicenow>false</servicenow>

        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // 1. Find a matching assignment rule
    var ruleGR = new GlideRecord('x_1603911_casepo_0_assignment_rule');
    ruleGR.addQuery('active', true);
    ruleGR.addQuery('category_match', current.ai_category);
    ruleGR.setLimit(1);
    ruleGR.query();
    // 2. If found, update the assignment group
    if (ruleGR.next()) {
        current.assignment_group = ruleGR.target_group;
        gs.addInfoMessage("Case automatically assigned to " + ruleGR.target_group.getDisplayValue() + " based on AI Category.");
    }
})(current, previous);
]]></script>

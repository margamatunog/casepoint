        <template><![CDATA[<div class="panel panel-default cp-panel">
  <div class="panel-heading">
    <h2 class="panel-title">Submit New Legal Case</h2>
  </div>
  <div class="panel-body">
    <div ng-if="c.data.submitted" class="alert alert-success">
      <i class="fa fa-check-circle"></i> Case <strong>{{c.data.new_case_number}}</strong> submitted successfully!
      <a href="?id=cp_my_cases" class="alert-link">View My Cases</a>
    </div>
    <form ng-if="!c.data.submitted" ng-submit="c.submitCase()">
      <!-- Requestor -->
      <div class="form-group">
        <label for="requestor">Requestor</label>
        <input type="text" class="form-control" id="requestor" value="{{::c.data.user_name}}" readonly>
      </div>
      <!-- Short Description -->
      <div class="form-group" ng-class="{'has-error': !c.short_desc && c.submitted_attempt}">
        <label for="short_desc">Subject <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="short_desc" ng-model="c.short_desc" placeholder="Brief summary of the issue" required>
      </div>
      <!-- Description -->
      <div class="form-group" ng-class="{'has-error': !c.description && c.submitted_attempt}">
        <label for="description">Detailed Description <span class="text-danger">*</span></label>
        <textarea class="form-control" id="description" rows="5" ng-model="c.description" placeholder="Provide full details..." required></textarea>
      </div>
      <!-- Attachment Placeholder -->
      <div class="form-group">
        <label>Attachments</label>
        <div class="attachment-area">
          <p class="text-muted"><i class="fa fa-paperclip"></i> Attachments will be available after submission.</p>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg" ng-disabled="c.submitting">
        <span ng-if="!c.submitting">Submit Case</span>
        <span ng-if="c.submitting"><i class="fa fa-spinner fa-spin"></i> Submitting...</span>
      </button>
    </form>
  </div>
</div>
]]></template>
    </sp_widget>
